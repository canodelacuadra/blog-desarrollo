---
import { SITE_DESCRIPTION, SITE_TITLE, withBase } from '../consts';
import HeaderLink from './HeaderLink.astro';
import Icon from './Icon.astro';
---

<header>
	<nav>
		<h2 class="brand">
			<img src={withBase('/logo.svg')} width="28" height="28" alt="" />
			<a href={withBase('/')}>
				{SITE_TITLE}
				<span class="tagline">| {SITE_DESCRIPTION}</span>
			</a>
		</h2>
		<div class="internal-links">
			<HeaderLink href={withBase('/')}><Icon name="lucide:house" size={16} /> Inicio</HeaderLink>
			<HeaderLink href={withBase('/blog')}><Icon name="lucide:newspaper" size={16} /> Blog</HeaderLink>
			<HeaderLink href={withBase('/proyectos')}><Icon name="lucide:briefcase" size={16} /> Proyectos</HeaderLink>
			<HeaderLink href={withBase('/about')}><Icon name="lucide:user-round" size={16} /> Acerca de mí</HeaderLink>
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: white;
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
	}
	h2 {
		margin: 0;
		font-size: 0.8em;
	}

	.brand {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.brand img {
		display: block;
	}

	.brand a {
		padding: 0;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	nav a {
		padding: 1em 0.5em;
		color: var(--black);
		border-bottom: 4px solid transparent;
		text-decoration: none;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}
	.tagline {
		color: rgb(var(--gray));
		font-weight: 400;
	}
	@media (max-width: 720px) {
		header {
			padding: 0 0.75em;
		}
		nav {
			flex-wrap: wrap;
			justify-content: center;
			gap: 0 0.25em;
			padding-top: 0.35em;
		}
		.brand {
			justify-content: center;
			width: 100%;
		}
		.tagline {
			display: none;
		}
		.internal-links {
			display: flex;
			flex-wrap: wrap;
			justify-content: center;
			width: 100%;
		}
		nav a {
			padding: 0.5em;
			font-size: 0.9em;
		}
	}
</style>
