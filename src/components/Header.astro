---
import { SITE_DESCRIPTION, SITE_TITLE, withBase } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<h2 class="brand">
			<img src={withBase('/logo.svg')} width="28" height="28" alt="" />
			<a href={withBase('/')}>{`${SITE_TITLE} | ${SITE_DESCRIPTION}`}</a>
		</h2>
		<div class="internal-links">
			<HeaderLink href={withBase('/')}>Inicio</HeaderLink>
			<HeaderLink href={withBase('/about')}>Acerca de mí</HeaderLink>
			<HeaderLink href={withBase('/blog')}>Blog</HeaderLink>
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: white;
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
	}
	h2 {
		margin: 0;
		font-size: 0.8em;
	}

	.brand {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.brand img {
		display: block;
	}

	.brand a {
		padding: 0;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	nav a {
		padding: 1em 0.5em;
		color: var(--black);
		border-bottom: 4px solid transparent;
		text-decoration: none;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}
</style>
