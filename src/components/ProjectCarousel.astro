---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import type { Project } from '../data/projects';

interface Props {
	projects: Project[];
}

const { projects } = Astro.props;
---

<section class="hero" data-carousel aria-labelledby="projects-heading">
	<div class="glow" aria-hidden="true"></div>

	<div class="hero-inner">
		<p class="eyebrow"><Icon name="lucide:briefcase" size={16} /> Portafolio</p>
		<h1 id="projects-heading">Proyectos que he construido</h1>
		<p class="subtitle">Un recorrido rápido por algunas de las cosas que he hecho. Desliza o usa las flechas.</p>

		<div class="track" data-track aria-roledescription="carrusel" aria-label="Proyectos realizados">
			{
				projects.map((project, index) => (
					<article
						class:list={['slide', index === 0 && 'is-active']}
						data-slide
						role="group"
						aria-roledescription="diapositiva"
						aria-label={`Proyecto ${index + 1} de ${projects.length}: ${project.title}`}
					>
						<Image
							src={project.image}
							alt={project.title}
							width={1200}
							height={675}
							loading={index === 0 ? 'eager' : 'lazy'}
						/>
						<div class="slide-content">
							<time class="slide-date" datetime={project.order}>{project.date}</time>
							<h2>{project.title}</h2>
							<p>{project.description}</p>
							<ul class="tags" aria-label="Tecnologías utilizadas">
								{project.tags.map((tag) => (
									<li>{tag}</li>
								))}
							</ul>
							<div class="links">
								{project.demoUrl && (
									<a href={project.demoUrl} target="_blank" rel="noopener noreferrer">
										<Icon name="lucide:external-link" size={16} /> Ver demo
									</a>
								)}
								{project.repoUrl && (
									<a href={project.repoUrl} target="_blank" rel="noopener noreferrer">
										<Icon name="lucide:github" size={16} /> Ver código
									</a>
								)}
							</div>
						</div>
					</article>
				))
			}
		</div>

		<div class="controls">
			<button type="button" class="arrow" data-prev aria-label="Proyecto anterior" disabled>
				<Icon name="lucide:chevron-left" size={20} />
			</button>
			<div class="dots" role="group" aria-label="Seleccionar proyecto">
				{
					projects.map((project, index) => (
						<button
							type="button"
							class:list={index === 0 && 'is-active'}
							data-dot
							aria-label={`Ir al proyecto ${index + 1}: ${project.title}`}
						/>
					))
				}
			</div>
			<span class="counter" aria-live="polite" data-counter>
				01 / {String(projects.length).padStart(2, '0')}
			</span>
			<button type="button" class="arrow" data-next aria-label="Proyecto siguiente">
				<Icon name="lucide:chevron-right" size={20} />
			</button>
		</div>
	</div>
</section>

<script>
	const root = document.querySelector<HTMLElement>('[data-carousel]');

	if (root) {
		const track = root.querySelector<HTMLElement>('[data-track]')!;
		const prev = root.querySelector<HTMLButtonElement>('[data-prev]')!;
		const next = root.querySelector<HTMLButtonElement>('[data-next]')!;
		const counter = root.querySelector<HTMLElement>('[data-counter]')!;
		const slides = Array.from(track.querySelectorAll<HTMLElement>('[data-slide]'));
		const dots = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-dot]'));
		const total = slides.length;
		const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

		let index = 0;

		const slideLeft = (slide: HTMLElement) =>
			slide.getBoundingClientRect().left - track.getBoundingClientRect().left + track.scrollLeft;

		const update = () => {
			const center = track.scrollLeft + track.clientWidth / 2;
			let closest = 0;
			let smallest = Infinity;

			slides.forEach((slide, i) => {
				const distance = Math.abs(slideLeft(slide) + slide.clientWidth / 2 - center);
				if (distance < smallest) {
					smallest = distance;
					closest = i;
				}
			});

			index = closest;
			slides.forEach((slide, i) => slide.classList.toggle('is-active', i === index));
			dots.forEach((dot, i) => {
				dot.classList.toggle('is-active', i === index);
				dot.setAttribute('aria-current', i === index ? 'true' : 'false');
			});
			counter.textContent = `${String(index + 1).padStart(2, '0')} / ${String(total).padStart(2, '0')}`;
			prev.disabled = index === 0;
			next.disabled = index === total - 1;
		};

		const goTo = (target: number) => {
			index = Math.max(0, Math.min(total - 1, target));
			const slide = slides[index];
			track.scrollTo({
				left: slideLeft(slide) - (track.clientWidth - slide.clientWidth) / 2,
				behavior: reduceMotion ? 'auto' : 'smooth',
			});
			update();
		};

		prev.addEventListener('click', () => goTo(index - 1));
		next.addEventListener('click', () => goTo(index + 1));
		dots.forEach((dot, i) => dot.addEventListener('click', () => goTo(i)));
		track.addEventListener('scroll', () => requestAnimationFrame(update), { passive: true });
		window.addEventListener('resize', update);

		update();
	}
</script>

<style>
	.hero {
		--hero-accent: #42bce3;
		position: relative;
		overflow: hidden;
		padding: 3.5rem 0 2.75rem;
		background: linear-gradient(135deg, #42bce3 0%, #2eaad6 55%, #1c90bf 100%);
		color: #063449;
	}
	.glow {
		position: absolute;
		top: -320px;
		right: -140px;
		width: 720px;
		height: 720px;
		border-radius: 50%;
		background: radial-gradient(circle, rgba(255, 255, 255, 0.35), transparent 70%);
		pointer-events: none;
	}
	.hero-inner {
		position: relative;
		z-index: 1;
		width: min(1100px, 92vw);
		margin: 0 auto;
	}
	.eyebrow {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		margin: 0 0 0.6rem;
		color: #05384d;
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}
	h1 {
		max-width: 18ch;
		margin: 0 0 0.65rem;
		color: #052e42;
		font-size: clamp(2.4rem, 5vw, 4.2rem);
		line-height: 1.05;
	}
	.subtitle {
		max-width: 44ch;
		margin: 0 0 2rem;
		color: rgba(5, 46, 66, 0.78);
		font-size: 1rem;
	}
	.track {
		display: flex;
		gap: 1.25rem;
		overflow-x: auto;
		scroll-snap-type: x mandatory;
		scrollbar-width: none;
		padding: 0.5rem 0 1.25rem;
	}
	.track::-webkit-scrollbar {
		display: none;
	}
	.slide {
		position: relative;
		flex: 0 0 min(82%, 900px);
		height: clamp(340px, 38vw, 460px);
		overflow: hidden;
		border: 1px solid rgba(255, 255, 255, 0.55);
		border-radius: 18px;
		background: #0b3f55;
		box-shadow: 0 20px 50px rgba(4, 52, 73, 0.28);
		scroll-snap-align: center;
		opacity: 0.7;
		transform: scale(0.965);
		transition:
			opacity 0.35s ease,
			transform 0.35s ease;
	}
	.slide.is-active {
		opacity: 1;
		transform: scale(1);
	}
	.slide img {
		display: block;
		width: 100%;
		height: 100%;
		border-radius: 0;
		object-fit: cover;
	}
	.slide::after {
		content: '';
		position: absolute;
		inset: 0;
		background: linear-gradient(
			to top,
			rgba(3, 40, 58, 0.9) 0%,
			rgba(3, 40, 58, 0.5) 42%,
			rgba(3, 40, 58, 0.02) 100%
		);
		pointer-events: none;
	}
	.slide-content {
		position: absolute;
		right: 0;
		bottom: 0;
		left: 0;
		z-index: 1;
		padding: 2rem 2.25rem;
	}
	.slide-date {
		display: inline-block;
		padding: 0.3rem 0.75rem;
		border: 1px solid rgba(255, 255, 255, 0.4);
		border-radius: 999px;
		color: rgba(255, 255, 255, 0.9);
		font-size: 0.7rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}
	.slide-content h2 {
		margin: 0.85rem 0 0.5rem;
		color: white;
		font-size: clamp(1.7rem, 3vw, 2.6rem);
		line-height: 1.1;
	}
	.slide-content p {
		max-width: 48ch;
		margin: 0;
		color: rgba(255, 255, 255, 0.82);
		font-size: 0.95rem;
		line-height: 1.5;
	}
	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin: 0.9rem 0;
		padding: 0;
		list-style: none;
	}
	.tags li {
		padding: 0.15rem 0.6rem;
		border: 1px solid rgba(255, 255, 255, 0.2);
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.1);
		color: white;
		font-size: 0.72rem;
		font-weight: 600;
	}
	.links {
		display: flex;
		flex-wrap: wrap;
		gap: 1.1rem;
	}
	.links a {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		color: var(--hero-accent);
		font-size: 0.9rem;
		font-weight: 600;
		text-decoration: none;
	}
	.links a:hover {
		color: white;
	}
	.controls {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 1rem;
	}
	.arrow {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2.5rem;
		height: 2.5rem;
		padding: 0;
		border: 1px solid rgba(5, 46, 66, 0.25);
		border-radius: 50%;
		background: rgba(255, 255, 255, 0.85);
		color: #05384d;
		cursor: pointer;
	}
	.arrow:hover:not(:disabled) {
		border-color: #05384d;
		background: white;
	}
	.arrow:disabled {
		opacity: 0.3;
		cursor: default;
	}
	.dots {
		display: flex;
		align-items: center;
		gap: 0.4rem;
	}
	.dots button {
		width: 0.55rem;
		height: 0.55rem;
		padding: 0;
		border: 0;
		border-radius: 999px;
		background: rgba(5, 56, 77, 0.28);
		cursor: pointer;
		transition: width 0.25s ease;
	}
	.dots button.is-active {
		width: 1.6rem;
		background: #05384d;
	}
	.counter {
		min-width: 4.5ch;
		color: rgba(5, 46, 66, 0.75);
		font-size: 0.85rem;
		font-variant-numeric: tabular-nums;
	}
	@media (max-width: 720px) {
		.hero {
			padding: 2.5rem 0 2rem;
		}
		.hero-inner {
			width: calc(100% - 1.5rem);
		}
		.subtitle {
			margin-bottom: 1.5rem;
		}
		.track {
			gap: 0.75rem;
		}
		.slide {
			flex-basis: 88%;
			height: 400px;
		}
		.slide-content {
			padding: 1.25rem;
		}
		.slide-content p {
			font-size: 0.85rem;
		}
		.controls {
			gap: 0.6rem;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.slide {
			transition: none;
		}
		.dots button {
			transition: none;
		}
	}
</style>
