---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import Icon from '../components/Icon.astro';
import { withBase } from '../consts';

type Props = CollectionEntry<'blog'>['data'] & { readingTime?: number };

const { title, description, pubDate, updatedDate, heroImage, readingTime } = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead title={title} description={description} image={heroImage} />
		<style>
			main {
				width: calc(100% - 2em);
				max-width: 100%;
				margin: 0;
			}
			.hero-image {
				width: 100%;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
			}
			.prose {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 1em;
				color: rgb(var(--gray-dark));
			}
			.title {
				margin-bottom: 1em;
				padding: 1em 0;
				text-align: center;
				line-height: 1;
			}
			.title h1 {
				margin: 0 0 0.5em 0;
			}
			.post-meta {
				display: flex;
				flex-wrap: wrap;
				justify-content: center;
				gap: 0.5rem 1.25rem;
				margin-bottom: 0.5em;
				color: rgb(var(--gray));
			}
			.meta-item {
				display: inline-flex;
				align-items: center;
				gap: 0.4em;
				font-size: 0.9rem;
			}
			.last-updated-on {
				margin: 0 0 0.5em;
				color: rgb(var(--gray));
				font-size: 0.85rem;
				font-style: italic;
			}
			.post-nav {
				margin-top: 2.5rem;
				padding-top: 1.5rem;
				border-top: 1px solid rgb(var(--gray-light));
			}
			.post-nav a {
				display: inline-flex;
				align-items: center;
				gap: 0.4em;
				font-size: 0.9rem;
				text-decoration: none;
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				<div class="hero-image">
					{heroImage && <Image width={1020} height={510} src={heroImage} alt={description} />}
				</div>
				<div class="prose">
					<div class="title">
						<div class="post-meta">
							<span class="meta-item">
								<Icon name="lucide:calendar-days" size={16} />
								<FormattedDate date={pubDate} />
							</span>
							{readingTime && (
								<span class="meta-item">
									<Icon name="lucide:clock" size={16} />
									{readingTime} min de lectura
								</span>
							)}
						</div>
						{updatedDate && (
							<p class="last-updated-on">
								Última actualización: <FormattedDate date={updatedDate} />
							</p>
						)}
						<h1>{title}</h1>
						<hr />
					</div>
					<slot />
					<nav class="post-nav" aria-label="Navegación del artículo">
						<a href={withBase('/blog')}>
							<Icon name="lucide:arrow-left" size={16} />
							Volver al blog
						</a>
					</nav>
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
