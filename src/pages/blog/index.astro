---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import Icon from '../../components/Icon.astro';
import { SITE_DESCRIPTION, SITE_TITLE, withBase } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const postCount = posts.length;
const dateFormatter = new Intl.DateTimeFormat('es-ES', {
	day: '2-digit',
	month: 'short',
	year: 'numeric',
});
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead title={`Blog | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 860px;
			}
			.page-head {
				display: flex;
				align-items: flex-end;
				justify-content: space-between;
				gap: 1rem;
				margin-bottom: 2.5rem;
				padding-bottom: 1.5rem;
				border-bottom: 1px solid rgb(var(--gray-light));
			}
			.eyebrow {
				display: inline-flex;
				align-items: center;
				gap: 0.4rem;
				margin: 0 0 0.5rem;
				color: var(--accent);
				font-size: 0.75rem;
				font-weight: 700;
				letter-spacing: 0.12em;
				text-transform: uppercase;
			}
			h1 {
				margin: 0 0 0.5rem;
			}
			.intro {
				max-width: 34rem;
				margin: 0;
				color: rgb(var(--gray));
				font-size: 0.95rem;
			}
			.count {
				margin: 0;
				color: rgb(var(--gray));
				font-size: 0.85rem;
				white-space: nowrap;
			}
			.post-list {
				margin: 0;
				padding: 0;
				list-style: none;
				border-top: 1px solid rgb(var(--gray-light));
			}
			.post-list li {
				border-bottom: 1px solid rgb(var(--gray-light));
			}
			.post-link {
				display: grid;
				grid-template-columns: 7.5rem 1fr auto;
				align-items: start;
				gap: 1.5rem;
				padding: 1.4rem 1rem;
				border-radius: 8px;
				color: inherit;
				text-decoration: none;
				transition:
					background-color 0.2s ease,
					transform 0.2s ease;
			}
			.post-link:hover {
				background-color: var(--accent-soft);
			}
			.post-date {
				padding-top: 0.3rem;
				color: rgb(var(--gray));
				font-size: 0.8rem;
				font-weight: 600;
				letter-spacing: 0.04em;
				line-height: 1.3;
				text-transform: uppercase;
			}
			.post-title {
				margin: 0 0 0.35rem;
				color: rgb(var(--black));
				font-size: 1.35rem;
				line-height: 1.3;
				transition: color 0.2s ease;
			}
			.post-link:hover .post-title {
				color: var(--accent);
			}
			.post-description {
				margin: 0;
				color: rgb(var(--gray));
				font-size: 0.9rem;
				line-height: 1.5;
			}
			.post-arrow {
				display: flex;
				align-items: center;
				align-self: center;
				color: rgb(var(--gray));
				transition:
					color 0.2s ease,
					transform 0.2s ease;
			}
			.post-link:hover .post-arrow {
				color: var(--accent);
				transform: translateX(4px);
			}
			.empty {
				color: rgb(var(--gray));
			}
			@media (max-width: 720px) {
				.page-head {
					align-items: flex-start;
					flex-direction: column;
				}
				.post-link {
					grid-template-columns: 1fr auto;
					gap: 0.35rem 1rem;
					padding: 1.1rem 0.5rem;
				}
				.post-date {
					grid-column: 1 / -1;
					padding-top: 0;
				}
				.post-title {
					font-size: 1.2rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<header class="page-head">
				<div>
					<p class="eyebrow"><Icon name="lucide:newspaper" size={16} /> Bitácora</p>
					<h1>Blog</h1>
					<p class="intro">
						Artículos prácticos sobre desarrollo web: Astro, HTML, CSS, JavaScript y las herramientas
						que uso a diario.
					</p>
				</div>
				<p class="count">
					{postCount} {postCount === 1 ? 'artículo' : 'artículos'}
				</p>
			</header>

			{posts.length > 0 ? (
				<ul class="post-list">
					{posts.map((post) => (
						<li>
							<a class="post-link" href={withBase(`/blog/${post.id}/`)}>
								<time class="post-date" datetime={post.data.pubDate.toISOString()}>
									{dateFormatter.format(post.data.pubDate).replace('.', '')}
								</time>
								<div>
									<h2 class="post-title">{post.data.title}</h2>
									<p class="post-description">{post.data.description}</p>
								</div>
								<span class="post-arrow">
									<Icon name="lucide:arrow-right" size={20} />
								</span>
							</a>
						</li>
					))}
				</ul>
			) : (
				<p class="empty">Todavía no hay artículos publicados.</p>
			)}
		</main>
		<Footer />
	</body>
</html>
